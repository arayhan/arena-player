{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:neon.tech)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:localhost)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(rtk *)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git init*)",
      "Bash(git worktree*)",
      "Bash(git stash*)",
      "Bash(git restore --staged*)",
      "Bash(git push origin main)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude*)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(rtk *)",
      "PowerShell(git status*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch*)",
      "PowerShell(git checkout*)",
      "PowerShell(git switch*)",
      "PowerShell(git init*)",
      "PowerShell(git worktree*)",
      "PowerShell(git stash*)",
      "PowerShell(git push origin main)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Bash(neonctl * delete*)",
      "Bash(wrangler r2 * delete*)",
      "PowerShell(neonctl * delete*)",
      "PowerShell(wrangler r2 * delete*)",
      "Bash(psql * -c *DROP*)",
      "PowerShell(psql * -c *DROP*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env*.local)",
      "Bash(shutdown*)",
      "PowerShell(shutdown*)",
      "Bash(format *)",
      "PowerShell(Format-Volume*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/inject-gotchas.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-claudemd.ps1",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-docs.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/notify.ps1 -Title \"Arena Player\" -Message \"Claude needs your input (permission or question)\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/notify.ps1 -Title \"Arena Player\" -Message \"Agent finished its task\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
