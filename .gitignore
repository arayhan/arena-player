# deps / build
node_modules/
.next/
out/
build/
coverage/
next-env.d.ts
*.tsbuildinfo
.vercel
*.pem

# env — never commit real keys
.env
.env.local
.env*.local

# claude personal overrides + temp screenshots
.claude/settings.local.json
.claude/screenshots/

# design references — local scratch only, deleted after analysis, never pushed.
# The README stays tracked because it documents the convention.
docs/references/*
!docs/references/README.md

# impeccable — NOT a blanket ignore. .impeccable/design.json is design authority
# (tonal ramps, semantic map, component HTML/CSS, the named rules) and IS tracked.
# Critique snapshots are point-in-time graded assessments that go stale the moment
# they are acted on; ignoring keeps them local, where /impeccable polish still reads them.
# live/ is machine-local config (dev command, port) and must never be committed.
.impeccable/critique/
.impeccable/live/

# misc
*.log
.DS_Store
.gstack/

# hook session markers — per-session state, never shared
.claude/.session-head
.claude/.claudemd-nudged
