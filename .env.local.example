# Copy to .env.local and fill in. Never commit .env.local.
# Setup instructions: db/README.md

# --- Neon (Postgres) ---
# Use the POOLED connection string (contains "-pooler"). Server-side only.
DATABASE_URL=

# --- Cloudflare R2 (private payment-proof bucket) ---
# Bucket must have public access DISABLED. Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arena-player-proofs

# --- Optional, not a secret ---
# Where check:shared looks for the byte-identical src/domain/ copy.
# Defaults to ../arena-player-admin. Set it only if that repo lives elsewhere.
# ARENA_ADMIN_PATH=

# --- Optional, not a secret ---
# The site's own origin. Empty in the browser, where requests are same-origin.
# Set it wherever there is no document to resolve a relative URL against:
# Node tests set it themselves in vitest.config.ts, and Phase 4 needs it for any
# server-side fetch. Read as BASE_URL in home.service.ts and api-client.ts.
# NEXT_PUBLIC_ is deliberate — an origin is not a secret. DATABASE_URL and the
# R2 keys stay server-only, per CLAUDE.md hard rule 4.
# NEXT_PUBLIC_SITE_URL=
