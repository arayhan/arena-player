# Copy to .env.local and fill in. Never commit .env.local.
# Setup instructions: db/README.md

# --- Neon (Postgres) ---
# Use the POOLED connection string (contains "-pooler"). Server-side only.
DATABASE_URL=

# --- Cloudflare R2 (private payment-proof bucket) ---
# Bucket must have public access DISABLED. Server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arena-player-proofs
